      "cell_type": "markdown",
      "source": [
        "# Non-Graphical Analysis (Value Counts & Unique Attributes)"
      ],
      "metadata": {
        "id": "G6VuOMgvQMRy"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "for col in df.columns:\n",
        "    print(f\"{col}: {df[col].nunique()} unique values\")\n"
      ],
