    {
      "cell_type": "markdown",
      "source": [
        "# Q4.2 — Confidence Intervals and Distribution of Mean Expenses"
      ],
      "metadata": {
        "id": "g6HVS69pWUB-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "def ci(data, confidence=0.95):\n",
        "    mean = np.mean(data)\n",
        "    std = np.std(data, ddof=1)\n",
        "    n = len(data)\n",
        "    z = 1.96  # for 95% confidence\n",
        "    moe = z * (std / np.sqrt(n))\n",
        "    return (mean - moe, mean + moe)\n",
        "\n",
        "male = df[df['Gender']=='M']['Purchase']\n",
        "female = df[df['Gender']=='F']['Purchase']\n",
        "\n",
        "ci_m = ci(male)\n",
        "ci_f = ci(female)\n",
        "print(\"95% CI for Male:\", ci_m)\n",
        "print(\"95% CI for Female:\", ci_f)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "FHI3bpJzWYaE",
        "outputId": "a7e07e3b-1270-49de-ad40-f13552fdde13"
      },
      "execution_count": 49,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "95% CI for Male: (np.float64(9422.019162420047), np.float64(9453.032918524483))\n",
            "95% CI for Female: (np.float64(8709.211081242413), np.float64(8759.920449068539))\n"
          ]
        }
      ]
